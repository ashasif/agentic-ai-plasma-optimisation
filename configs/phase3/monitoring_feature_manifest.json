{
  "dataset_name": "phase3_monitoring_episodes",
  "dataset_version": "1.0.0",
  "purpose": "leakage-safe feature contract for synthetic process monitoring and fault diagnosis",
  "features": [
    "nominal_absorbed_power_W",
    "target_pressure_mTorr",
    "nominal_flow_sccm",
    "measured_absorbed_power_W",
    "measured_flow_sccm",
    "measured_pressure_mTorr"
  ],
  "binary_target": "fault_effect_active",
  "multiclass_target": "active_fault_family",
  "group_columns": [
    "episode_id",
    "split"
  ],
  "ordering_column": "step_index",
  "protected_ground_truth": [
    "fault_present",
    "fault_domain",
    "fault_family",
    "fault_profile",
    "fault_severity",
    "fault_direction",
    "fault_magnitude_fraction",
    "fault_onset_step",
    "fault_started",
    "fault_progress",
    "signed_fault_fraction",
    "fault_factor",
    "active_fault_domain",
    "normal_power_coupling_factor",
    "normal_flow_delivery_factor",
    "normal_pumping_effectiveness_factor",
    "applied_power_factor",
    "applied_flow_factor",
    "applied_pumping_factor",
    "true_absorbed_power_W",
    "true_flow_sccm",
    "true_pumping_speed_m3_s",
    "true_neutral_density_m3",
    "true_ion_density_m3",
    "true_electron_density_m3",
    "true_electron_energy_density_J_m3",
    "true_electron_temperature_eV",
    "true_pressure_mTorr",
    "true_pressure_relative_deviation_from_target",
    "power_measurement_noise_factor",
    "flow_measurement_noise_factor",
    "pressure_measurement_noise_factor",
    "power_measurement_relative_noise",
    "flow_measurement_relative_noise",
    "pressure_measurement_relative_noise",
    "pressure_sensor_bias_factor",
    "pressure_sensor_bias_fraction"
  ],
  "notes": [
    "step_index is an ordering key, not calibrated physical time",
    "episode_id and split are grouping metadata and are not model features",
    "true process, plasma-state, fault, variability, and noise fields are protected evaluation ground truth",
    "measured absorbed power is a synthetic absorbed-power estimate and is not generator RF power",
    "no synthetic measured electron-density or electron-temperature diagnostic is fabricated"
  ]
}
