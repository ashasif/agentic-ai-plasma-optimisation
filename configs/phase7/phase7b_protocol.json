                                           "single_canonical_exception_class":  true
                                       },
    "monitoring_adapter":  {
                               "class_name":  "TrustedMonitoringAdapter",
                               "evidence_type":  "TrustedMonitoringEvidence",
                               "constructor_contract":  {
                                                            "trusted_loader":  "plasma_ai.monitoring.phase5g_persistence.load_phase5g_monitoring",
                                                            "default_manifest_path":  "artifacts/phase5/monitoring_manifest.json",
                                                            "alternate_manifest_path_permitted":  false,
                                                            "direct_model_artifact_loading_permitted":  false,
                                                            "development_interface_import_permitted":  false,
                                                            "public_constructor_signature":  "TrustedMonitoringAdapter()",
                                                            "default_protocol_path":  "configs/phase5/phase5g_protocol.json",
                                                            "alternate_protocol_path_permitted":  false,
                                                            "runtime_loaded_eagerly_on_construction":  true,
                                                            "maximum_loader_calls_per_instance":  1,
                                                            "public_dependency_injection_permitted":  false
                                                        },
                               "input_contract":  {
                                                      "semantic_unit":  "one current monitoring observation",
                                                      "input_type":  "Mapping[str, object]",
                                                      "exact_required_fields":  [
                                                                                    "nominal_absorbed_power_W",
                                                                                    "target_pressure_mTorr",
                                                                                    "nominal_flow_sccm",
                                                                                    "measured_absorbed_power_W",
                                                                                    "measured_flow_sccm",
                                                                                    "measured_pressure_mTorr"
                                                                                ],
                                                      "additional_fields_permitted":  false,
                                                      "missing_fields_permitted":  false,
                                                      "values_must_be_real_numeric":  true,
                                                      "bool_values_permitted_as_numeric":  false,
                                                      "values_must_be_finite":  true,
                                                      "strictly_positive_fields":  [
                                                                                       "nominal_absorbed_power_W",
                                                                                       "target_pressure_mTorr",
                                                                                       "nominal_flow_sccm"
                                                                                   ],
                                                      "phase7_authoritative_rows":  1,
                                                      "upstream_batch_interface_exposed":  false,
                                                      "runtime_array_shape":  "[1, 6]",
                                                      "feature_order":  [
                                                                            "nominal_absorbed_power_W",
                                                                            "target_pressure_mTorr",
                                                                            "nominal_flow_sccm",
                                                                            "measured_absorbed_power_W",
                                                                            "measured_flow_sccm",
                                                                            "measured_pressure_mTorr"
                                                                        ]
                                                  },
                               "upstream_call_contract":  {
                                                              "only_prediction_method":  "LoadedPhase5GMonitoring.predict",
                                                              "direct_detector_call_permitted":  false,
                                                              "direct_diagnoser_call_permitted":  false,
                                                              "build_phase5g_model_features_direct_call_permitted":  false,
                                                              "maximum_predict_calls_per_adapter_call":  1
                                                          },
                               "output_contract":  {
                                                       "immutable":  true,
                                                       "scalarised_from_exact_single_row":  true,
                                                       "fields":  [
                                                                      "active_probability",
                                                                      "fault_active",
                                                                      "diagnostic_state",
                                                                      "monitoring_manifest_sha256"
                                                                  ],
                                                       "active_probability_type":  "float",
                                                       "fault_active_type":  "bool",
                                                       "diagnostic_state_type":  "str",
                                                       "monitoring_manifest_sha256_type":  "str",
                                                       "active_probability_minimum":  0,
                                                       "active_probability_maximum":  1,
                                                       "detector_threshold":  0.4,
                                                       "threshold_rule":  "fault_active == (active_probability \u003e= 0.4)",
                                                       "diagnostic_states":  [
                                                                                 "none",
                                                                                 "flow_delivery",
                                                                                 "power_coupling",
                                                                                 "pressure_path_anomaly"
                                                                             ],
                                                       "inactive_consistency_rule":  "fault_active is false implies diagnostic_state == \u0027none\u0027",
                                                       "active_consistency_rule":  "fault_active is true implies diagnostic_state in active diagnostic vocabulary",
                                                       "pressure_path_specific_mechanism_claim_permitted":  false,
                                                       "implementation_form":  "frozen_dataclass"
                                                   },
                               "integrity_contract":  {
                                                          "frozen_manifest_path":  "artifacts/phase5/monitoring_manifest.json",
                                                          "frozen_manifest_sha256":  "a18afb158aa7c02ac0e345b5f238a91e34f876d10dd43218c574554b874a9259",
                                                          "detector_sha256":  "4a00e785d7e7f0a8429020399967cdd82c18da275d58e5b83bc11707eeac8a6a",
                                                          "diagnoser_sha256":  "2e9dea016137594c707ecd3c32116691cc90d0127133f11c70372c93e6fcca84",
                                                          "phase5g_protocol_sha256":  "2ca15b486bf15c3c439e19607812358f632151c94de15541ae6d27e04fe1574c",
                                                          "persistence_equivalence_sha256":  "6f53ac1c9b919172bde8a2030ecbedaabab94f0aa5dbac3e6cd68f534cb1feb9",
                                                          "hash_mismatch_action":  "raise_TrustedBoundaryError",
                                                          "loader_failure_action":  "raise_TrustedBoundaryError",
                                                          "prediction_failure_action":  "raise_TrustedBoundaryError",
                                                          "invalid_output_action":  "raise_TrustedBoundaryError"
                                                      }
