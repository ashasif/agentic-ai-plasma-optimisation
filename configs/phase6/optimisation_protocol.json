  "objective_definitions": {
    "boundary_margin_cost": "0.5 - normalized_boundary_margin",
    "density_relative_error": "abs(predicted_density - target_density) / target_density",
    "normalized_absorbed_power": "(power - 15.0) / 75.0",
    "normalized_boundary_margin": "min((power - 15.0) / 75.0, (90.0 - power) / 75.0, (pressure - 10.0) / 50.0, (60.0 - pressure) / 50.0)",
    "normalized_nominal_distance": "sqrt(((power - nominal_power) / 75.0)^2 + ((pressure - nominal_pressure) / 50.0)^2)",
    "pareto_diagnostics_required_for_multiobjective_grid": true,
    "raw_components_must_be_reported": true,
    "scalarised_score_may_hide_tradeoffs": false
  },
